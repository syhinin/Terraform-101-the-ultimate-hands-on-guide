# Local .terraform directories
.terraform/

# State files may contain sensitive values (e.g. api_key)
*.tfstate
*.tfstate.*
terraform.tfstate.d/
.terraform.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# tfvars are kept in this repo as lesson examples; never put real secrets in them

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
